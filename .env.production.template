# Production Environment Variables
# SECURITY WARNING: Do NOT commit this file to version control
# Copy this file to .env.production and fill in actual values

# ========================================
# Database Configuration
# ========================================
DB_HOST=your-production-db-host.com
DB_PORT=3306
DB_NAME=carboncalc
DB_USER=carboncalc_user
DB_PASSWORD=STRONG_RANDOM_PASSWORD_HERE

# ========================================
# JWT Configuration
# ========================================
# Generate a strong random secret (minimum 256 bits)
# Use: openssl rand -base64 64
JWT_SECRET=GENERATE_STRONG_RANDOM_SECRET_KEY_HERE_MIN_256_BITS
JWT_EXPIRATION=3600000

# ========================================
# Email Configuration
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-production-email@domain.com
MAIL_PASSWORD=your-app-specific-password

# ========================================
# External API Keys
# ========================================
CARBON_INTERFACE_API_KEY=your-carbon-interface-api-key
CLIMATIQ_API_KEY=your-climatiq-api-key

# ========================================
# Application Configuration
# ========================================
API_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Default location settings
DEFAULT_COUNTRY=US
DEFAULT_STATE=CA

# ========================================
# Logging Configuration (Optional)
# ========================================
LOG_LEVEL=INFO
LOG_PATH=/var/log/carbon-calc
