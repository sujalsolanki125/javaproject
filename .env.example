# Local Development Environment Variables
# Safe to commit - contains no sensitive data

# Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_NAME=carboncalc
DB_USER=root
DB_PASSWORD=your-local-password

# JWT Configuration
JWT_SECRET=dev-secret-key-not-for-production-use-only-for-local-development
JWT_EXPIRATION=86400000

# Email Configuration (use test credentials)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=test@example.com
MAIL_PASSWORD=test-password

# External API Keys (use test/sandbox keys)
CARBON_INTERFACE_API_KEY=your-dev-api-key
CLIMATIQ_API_KEY=your-dev-api-key

# Application Configuration
API_PORT=8080
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=dev

# Default location settings
DEFAULT_COUNTRY=US
DEFAULT_STATE=CA
